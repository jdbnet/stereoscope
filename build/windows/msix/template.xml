<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="stereoscope"
        Arguments=""
        InstallLocation="C:\Program Files\StereoScope\StereoScope">
    </Installer>
    <PackageInformation
        PackageName="StereoScope"
        PackageDisplayName="StereoScope"
        PublisherName="CN=StereoScope"
        PublisherDisplayName="StereoScope"
        Version="0.1.0.0"
        PackageDescription="See which stereo channels are playing, and which apps are playing them.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.stereoscope.app"
                Description="See which stereo channels are playing, and which apps are playing them."
                DisplayName="StereoScope"
                ExecutableName="stereoscope"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>StereoScope</DisplayName>
            <PublisherDisplayName>StereoScope</PublisherDisplayName>
            <Description>See which stereo channels are playing, and which apps are playing them.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="stereoscope.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
